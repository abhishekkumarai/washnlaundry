# Cloudflare Pages cache-control (mirrors vercel.json's header rules).
# index.html and the service worker/bootstrap must never be served stale, or
# a client can get stuck on an old build after a redeploy.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/flutter_bootstrap.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/flutter_service_worker.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/version.json
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# main.dart.js is NOT content-hashed, so it must revalidate on every load (a cheap
# 304 when unchanged). Without this, a browser keeps running the previous build
# for hours after a deploy, e.g. still calling a backend that has since moved.
/main.dart.js
  Cache-Control: no-cache

# Hashed/immutable build assets can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable

/*.wasm
  Cache-Control: public, max-age=31536000, immutable
