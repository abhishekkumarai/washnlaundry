{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "washnlaundry-crm-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "vars": {
    "BACKEND_ORIGIN": "https://washnlaundry-backend.onrender.com"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "dev": {
      "name": "washnlaundry-crm-api-dev",
      "vars": {
        "BACKEND_ORIGIN": "https://washnlaundry-backend-dev.onrender.com"
      },
      "observability": {
        "enabled": true
      }
    }
  }
}
