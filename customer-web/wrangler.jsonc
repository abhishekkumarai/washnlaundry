{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "washnlaundry-customer",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "customer.washnlaundry.com", "custom_domain": true }
  ],
  "vars": {
    "BACKEND_ORIGIN": "https://laundrybill-backend.onrender.com"
  },
  "observability": {
    "enabled": true
  }
}
