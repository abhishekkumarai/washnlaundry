# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# cloudflare / opennext
/.open-next/
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# secrets exported for a host, e.g. washnlaundry-backend.env
*.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# old customer portal leftovers (removed 2026-10-07): installs and build output
customer-web/node_modules/
customer-web/.next/
customer-web/.open-next/
customer-web/.wrangler/
customer-web/tsconfig.tsbuildinfo
customer-web/next-env.d.ts

# local notes
/projects.md

# sqlite & local backups
*.sqlite3*
crm/backend/backups/
crm/backend/*.sqlite3*
