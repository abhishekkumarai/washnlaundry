#!/bin/sh
# Git pre-push hook. Only pushes to main do anything, and only for the parts of
# the repo that actually changed:
#   backend/**                                   -> Django tests (Render then auto-deploys the backend)
#   washnlaundrycrm/** or the Vercel deploy script -> Flutter tests + build + Vercel deploy
#   anything else (bridge, docs, Cloudflare Workers) -> nothing
# Cloudflare deploys (Pages + Workers) live on the `cloudflare` branch, not here.
# A first push / unknown base is treated as "everything changed".
# Requires VERCEL_TOKEN for the CRM deploy (see scripts/deploy_vercel.js).
# Set PREPUSH_DRY_RUN=1 to print what would run instead of running it.

zero="0000000000000000000000000000000000000000"

run() {
    if [ -n "$PREPUSH_DRY_RUN" ]; then
        echo "[dry-run] $*"
        return 0
    fi
    "$@"
}

banner() {
    echo "=========================================================="
    echo "  $1"
    echo "=========================================================="
}

while read local_ref local_oid remote_ref remote_oid
do
    [ "$remote_ref" = "refs/heads/main" ] || continue
    [ "$local_oid" = "$zero" ] && continue   # branch deletion

    do_backend=0
    do_crm=0
    if [ "$remote_oid" = "$zero" ]; then
        do_backend=1
        do_crm=1
    elif changed=$(git diff --name-only "$remote_oid" "$local_oid" 2>/dev/null); then
        echo "$changed" | grep -q '^backend/' && do_backend=1
        echo "$changed" | grep -qE '^(washnlaundrycrm/|scripts/deploy_vercel\.js)' && do_crm=1
    else
        echo "Pre-push: cannot diff against remote main; treating everything as changed."
        do_backend=1
        do_crm=1
    fi

    if [ "$do_backend" = 0 ] && [ "$do_crm" = 0 ]; then
        banner "Pre-push: no backend or CRM changes - nothing to test or deploy."
        continue
    fi

    if [ "$do_backend" = 1 ]; then
        banner "Pre-push: backend changed - running Django tests..."
        run sh -c 'cd backend && python manage.py test api'
        if [ $? -ne 0 ]; then
            echo "Error: Backend tests failed. Push aborted." >&2
            exit 1
        fi
    fi

    if [ "$do_crm" = 1 ]; then
        banner "Pre-push: CRM changed - Flutter tests..."
        run sh -c 'cd washnlaundrycrm && flutter test test/staff_test.dart test/screens_test.dart'
        if [ $? -ne 0 ]; then
            echo "Error: Flutter tests failed. Push aborted." >&2
            exit 1
        fi

        banner "Building Flutter Web release bundle..."
        run sh -c 'cd washnlaundrycrm && flutter build web --release --dart-define=API_BASE_URL=https://laundrybill-backend.onrender.com/api'
        if [ $? -ne 0 ]; then
            echo "Error: Flutter Web build failed. Push aborted." >&2
            exit 1
        fi

        banner "Deploying updated frontend to Vercel production..."
        run node scripts/deploy_vercel.js
        if [ $? -ne 0 ]; then
            echo "Error: Vercel deploy failed. Push aborted." >&2
            exit 1
        fi
    fi

    banner "Pre-push verification & deployment completed successfully!"
done

exit 0
