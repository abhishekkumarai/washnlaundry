# Copy this file to `.env` (docker compose reads it automatically) and fill
# in a real value to turn on Google Sign-In for `docker compose up --build`.
#
# Get one from Google Cloud Console: Credentials > Create Credentials >
# OAuth client ID > Application type "Web application". Add these as
# Authorized JavaScript origins:
#   http://localhost:8080          (the Docker path this compose file runs)
#   http://localhost:<port>        (whatever port `flutter run -d chrome` uses,
#                                    if you also sign in from that faster loop)
# Leave Authorized redirect URIs empty — Google Identity Services signs in via
# its own rendered button and a JS callback, not a server redirect.
#
# Until this is set, the app runs with GOOGLE_CLIENT_ID empty: the login
# screen omits the Google button and Demo Mode (see AuthProvider.signInAsDemo)
# is the only sign-in path — see CLAUDE.md's "Authentication" section.
GOOGLE_CLIENT_ID=

# Shared secret for the washnlaundry-rag Cloudflare Worker (KAN-112). Must
# match the Worker's own RAG_API_KEY (`wrangler secret put RAG_API_KEY` in
# cloudflare/rag-engine/). Only the backend ever sends this — never bake it
# into the Flutter web bundle, which anyone can read from the compiled JS.
RAG_API_KEY=

# Set to "true" to have the WhatsApp bridge auto-reply to inbound customer
# messages using the RAG assistant (KAN-112). This is a real production
# behaviour change on the real, already-linked WhatsApp session — real
# customers get AI replies — so it defaults to off (see
# whatsapp-bridge/src/autoReply.js). Verify RAG_API_KEY works first.
WHATSAPP_AUTO_REPLY=false

# Resend API key for emailing website-chat leads (backend). Real value goes in .env.
RESEND_API_KEY=
